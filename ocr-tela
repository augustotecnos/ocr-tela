#!/usr/bin/env python3
"""OCR de área da tela para GNOME/Wayland, no estilo do Snipping Tool do Windows.

Congela a tela, você arrasta a seleção e, ao soltar o botão, o texto reconhecido
vai direto para o clipboard. Sem janela de preview, sem barra de ferramentas e
sem nenhuma imagem deixada em disco.
"""
import os
import shutil
import subprocess
import sys
from urllib.parse import unquote

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("Graphene", "1.0")
gi.require_version("Gio", "2.0")
from gi.repository import Gdk, Gio, GLib, Graphene, Gtk


VERSION = "1.0.0"
APP_ID = "io.github.augustotecnos.ocr-tela"


def _env(name, default):
    return os.environ.get(name, default)


LANG = _env("OCR_LANG", "por")                  # idiomas do tesseract, ex.: "por+eng"
TESSDATA = os.path.expanduser(_env("OCR_TESSDATA", ""))   # vazio = modelos do sistema
MAX_SIDE = int(_env("OCR_MAX_SIDE", "1400"))    # recortes maiores são reduzidos
DIM = float(_env("OCR_DIM", "0.45"))            # escurecimento fora da seleção
NOTIFY = _env("OCR_NOTIFY", "1") != "0"         # 0 = totalmente silencioso
MIN_SEL = 8                                     # abaixo disso é clique, não seleção

TMP_SHOT = f"/tmp/ocr-tela-{os.getpid()}.png"
TMP_CROP = f"/tmp/ocr-tela-{os.getpid()}-crop.png"


def notify(msg):
    if NOTIFY:
        subprocess.run(["notify-send", "-t", "2500", "-a", "OCR de tela", "OCR", msg])


def cleanup():
    for path in (TMP_SHOT, TMP_CROP):
        try:
            os.unlink(path)
        except OSError:
            pass


def grab_screen():
    """Captura a área de trabalho inteira pelo portal, sem exibir UI nenhuma.

    O portal grava o PNG na pasta de imagens do usuário; movemos na hora para
    /tmp para não deixar rastro. Devolve o caminho do arquivo, ou None.
    """
    loop = GLib.MainLoop()
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    desktop = Gio.DBusProxy.new_sync(
        bus, Gio.DBusProxyFlags.NONE, None,
        "org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
        "org.freedesktop.portal.Screenshot", None,
    )
    opts = {"interactive": GLib.Variant("b", False)}
    handle = desktop.call_sync(
        "Screenshot", GLib.Variant("(sa{sv})", ("", opts)),
        Gio.DBusCallFlags.NONE, 5000, None,
    ).unpack()[0]

    out = {}

    def on_response(proxy, sender, signal, params):
        response, results = params.unpack()
        out["ok"] = response == 0
        out["uri"] = results.get("uri", "")
        loop.quit()

    request = Gio.DBusProxy.new_for_bus_sync(
        Gio.BusType.SESSION, Gio.DBusProxyFlags.NONE, None,
        "org.freedesktop.portal.Desktop", handle,
        "org.freedesktop.portal.Request", None,
    )
    request.connect("g-signal", on_response)
    loop.run()

    if not out.get("ok"):
        return None
    src = unquote(out["uri"].replace("file://", ""))
    if not os.path.exists(src):
        return None
    shutil.move(src, TMP_SHOT)
    return TMP_SHOT


def _rect(x0, y0, dx, dy):
    """Ponto inicial + deslocamento -> (x, y, largura, altura), sempre positivos."""
    return min(x0, x0 + dx), min(y0, y0 + dy), abs(dx), abs(dy)


class SelectionOverlay(Gtk.Widget):
    """Desenha a tela congelada, o escurecimento e o retângulo da seleção.

    Cada instância cobre um monitor e mostra apenas a fatia correspondente da
    captura, que é da área de trabalho inteira.
    """

    def __init__(self, texture, origin, span):
        super().__init__()
        self._texture = texture
        self._origin = origin      # canto deste monitor, em pixels da imagem
        self._span = span          # tamanho deste monitor, em pixels da imagem
        self.rect = None           # seleção atual, em coordenadas do widget
        self.set_hexpand(True)
        self.set_vexpand(True)

    def _texture_rect(self, w, h):
        """Onde desenhar a textura inteira para a fatia deste monitor preencher o widget."""
        ox, oy = self._origin
        kx, ky = w / self._span[0], h / self._span[1]
        return Graphene.Rect().init(-ox * kx, -oy * ky,
                                    self._texture.get_width() * kx,
                                    self._texture.get_height() * ky)

    def do_snapshot(self, snapshot):
        w, h = self.get_width(), self.get_height()
        if w <= 0 or h <= 0:
            return
        bounds = Graphene.Rect().init(0, 0, w, h)
        dest = self._texture_rect(w, h)

        shade = Gdk.RGBA()
        shade.red = shade.green = shade.blue = 0.0
        shade.alpha = DIM

        snapshot.push_clip(bounds)
        snapshot.append_texture(self._texture, dest)      # tela congelada
        snapshot.append_color(shade, bounds)              # escurece tudo

        if self.rect:
            x, y, rw, rh = self.rect
            snapshot.push_clip(Graphene.Rect().init(x, y, rw, rh))
            snapshot.append_texture(self._texture, dest)  # brilho na seleção
            snapshot.pop()

            line = Gdk.RGBA()
            line.red = line.green = line.blue = line.alpha = 1.0
            for edge in ((x, y, rw, 1), (x, y + rh - 1, rw, 1),
                         (x, y, 1, rh), (x + rw - 1, y, 1, rh)):
                snapshot.append_color(line, Graphene.Rect().init(*edge))

        snapshot.pop()


def select_area(png):
    """Congela a tela e deixa o usuário arrastar a seleção.

    Abre uma janela por monitor, cada uma desenhando a fatia correspondente da
    captura. Devolve (x, y, w, h) em pixels da imagem, ou None se cancelado.
    """
    texture = Gdk.Texture.new_from_filename(png)
    iw, ih = texture.get_width(), texture.get_height()
    result = {"rect": None}

    app = Gtk.Application(application_id=APP_ID,
                          flags=Gio.ApplicationFlags.NON_UNIQUE)

    def on_activate(application):
        monitors = Gdk.Display.get_default().get_monitors()
        geoms = [monitors.get_item(i).get_geometry()
                 for i in range(monitors.get_n_items())]

        # Área de trabalho em coordenadas lógicas -> fator para pixels da imagem.
        fx = iw / max(g.x + g.width for g in geoms)
        fy = ih / max(g.y + g.height for g in geoms)

        windows = []

        def close_all():
            for win in windows:
                win.close()

        for index in range(monitors.get_n_items()):
            monitor = monitors.get_item(index)
            geom = geoms[index]

            win = Gtk.ApplicationWindow(application=application)
            win.set_decorated(False)
            win.fullscreen_on_monitor(monitor)
            win.set_cursor(Gdk.Cursor.new_from_name("crosshair", None))

            overlay = SelectionOverlay(texture,
                                       (geom.x * fx, geom.y * fy),
                                       (geom.width * fx, geom.height * fy))
            win.set_child(overlay)
            start = {"pos": (0, 0)}

            def on_begin(gesture, x, y, start=start, overlay=overlay):
                start["pos"] = (x, y)
                overlay.rect = None

            def on_update(gesture, dx, dy, start=start, overlay=overlay):
                overlay.rect = _rect(*start["pos"], dx, dy)
                overlay.queue_draw()

            def on_end(gesture, dx, dy, start=start, overlay=overlay, geom=geom):
                x, y, w, h = _rect(*start["pos"], dx, dy)
                if w >= MIN_SEL and h >= MIN_SEL:
                    lw, lh = overlay.get_width(), overlay.get_height()
                    # Coordenadas da janela -> lógicas globais -> pixels da imagem.
                    gx = geom.x + x * geom.width / lw
                    gy = geom.y + y * geom.height / lh
                    gw = w * geom.width / lw
                    gh = h * geom.height / lh
                    result["rect"] = (int(gx * fx), int(gy * fy),
                                      max(1, int(gw * fx)), max(1, int(gh * fy)))
                close_all()

            gesture = Gtk.GestureDrag()
            gesture.connect("drag-begin", on_begin)
            gesture.connect("drag-update", on_update)
            gesture.connect("drag-end", on_end)
            overlay.add_controller(gesture)

            keys = Gtk.EventControllerKey()

            def on_key(controller, keyval, keycode, mods):
                if keyval == Gdk.KEY_Escape:
                    close_all()
                    return True
                return False

            keys.connect("key-pressed", on_key)
            win.add_controller(keys)

            windows.append(win)

        for win in windows:
            win.present()

    app.connect("activate", on_activate)
    app.run([])
    return result["rect"]


def ocr(png, rect):
    """Recorta a região, reduz se for grande demais e devolve o texto lido."""
    import PIL.Image

    x, y, w, h = rect
    img = PIL.Image.open(png).crop((x, y, x + w, y + h))
    if max(img.size) > MAX_SIDE:
        scale = MAX_SIDE / max(img.size)
        img = img.resize((max(1, int(img.width * scale)),
                          max(1, int(img.height * scale))), PIL.Image.LANCZOS)
    img.save(TMP_CROP)

    env = dict(os.environ)
    if TESSDATA and os.path.isdir(TESSDATA):
        env["TESSDATA_PREFIX"] = TESSDATA

    def run(psm):
        return subprocess.run(
            ["tesseract", TMP_CROP, "stdout", "-l", LANG, "--oem", "1", "--psm", psm],
            capture_output=True, text=True, env=env,
        ).stdout.strip()

    return run("6") or run("3")      # bloco de texto, com fallback automático


def main():
    if "--version" in sys.argv:
        print(f"ocr-tela {VERSION}")
        return 0

    try:
        shot = grab_screen()
        if not shot:
            notify("Não consegui capturar a tela")
            return 1

        rect = select_area(shot)
        if not rect:
            return 0                 # cancelado: sai calado, como no Windows

        text = ocr(shot, rect)
        if not text:
            notify("Nenhum texto reconhecido")
            return 0

        proc = subprocess.Popen(["wl-copy"], stdin=subprocess.PIPE)
        proc.communicate(text.encode())
        notify(f"Texto copiado ({len(text)} caracteres)")
        return 0
    finally:
        cleanup()


if __name__ == "__main__":
    sys.exit(main())
